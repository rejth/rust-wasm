{
  "name": "wasm-transfer-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wasm-pack build --target nodejs",
    "build:web": "wasm-pack build --target web",
    "build:docs": "cargo doc --open",
    "demo": "node examples/demo.js",
    "demo:benchmark": "node examples/benchmark.js",
