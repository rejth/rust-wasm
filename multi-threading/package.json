{
  "name": "multi-threading",
  "version": "0.1.0",
  "scripts": {
    "wasm": "cargo build --target wasm32-unknown-unknown --release && wasm-bindgen target/wasm32-unknown-unknown/release/multi_threading.wasm --out-dir pkg --target web",
    "dev": "npm run wasm && webpack serve --open",
    "build": "rimraf dist && npm run wasm && webpack --mode production",
    "test": "cargo test && wasm-pack test --headless",
    "format": "cargo fmt && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,glsl}\"",
    "lint": "eslint \"./js\" --ext .js,.jsx"
  },
  "dependencies": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "rimraf": "^6.0.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
