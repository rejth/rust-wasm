{
  "name": "webgl-sandbox",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wasm-pack build --target web && vite",
    "build": "wasm-pack build --target web --release && vite build",
    "preview": "vite preview",
    "test": "cargo test && wasm-pack test --headless",
    "format": "cargo fmt && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,glsl}\"",
    "lint": "eslint \"./js\" --ext .js,.jsx"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.35.0",
    "prettier-plugin-glsl": "^0.2.2",
    "vite": "^6.0.3",
    "vite-plugin-glsl": "^1.3.0",
    "vite-plugin-wasm": "^3.3.0"
  }
}
